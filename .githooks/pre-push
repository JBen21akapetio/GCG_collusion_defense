#!/bin/sh
# Refuse tout push direct vers main : on passe par une branche et une PR.
#
# Installation (une fois, par personne) :
#     git config core.hooksPath .githooks
#
# Contournement ponctuel, en connaissance de cause :
#     ALLOW_PUSH_MAIN=1 git push origin main

protected="refs/heads/main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "$protected" ] && [ "$ALLOW_PUSH_MAIN" != "1" ]; then
        echo ""
        echo "  ✗ Push direct sur main refusé."
        echo ""
        echo "    Passez par une branche :"
        echo "      git switch -c ma-tache"
        echo "      git push -u origin ma-tache"
        echo "      gh pr create --fill"
        echo ""
        echo "    Si c'est vraiment nécessaire :"
        echo "      ALLOW_PUSH_MAIN=1 git push origin main"
        echo ""
        exit 1
    fi
done

exit 0
